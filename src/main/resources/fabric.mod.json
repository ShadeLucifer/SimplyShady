{
  "schemaVersion": 1,
  "id": "terraponbta",
  "version": "${version}",

  "name": "TerraponBTA",
  "description": "Adds 3 new metals and tiers for such",
  "authors": [
    "Turnip Labs for the example mod",
		"CalamityKage, created the concept and assets as well as put the code together",
		"Useless since I used his MoonMoonMoon Fortune/Loot code",
		"_CantComplain for the Fire Immunity Code as well as the Fire Damage code",
		"LukeisStuff's Randomite Ore mod so I can figure out how to generate the ores"
  ],
  "contact": {
    "homepage": "https://github.com/ShadeLucifer/TerraponBTA",
    "sources": ""
  },

	"icon": "icon.png",
  "license": "CC0-1.0",

  "environment": "*",
  "entrypoints": {
