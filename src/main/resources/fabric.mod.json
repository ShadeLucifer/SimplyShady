			"calamitykage.terraponbta.TerraponBTA"
		],
		"terrain-api": [
			"calamitykage.terraponbta.plugins.TerrainApiPlugin"
		],
		"recipesReady": [
			"calamitykage.terraponbta.recipes.TerraponBTARecipes"
		]
	},
  "mixins": [
		"terraponbta.mixins.json"
  ],
	"accessWidener": "terraponbta.accesswidener",
  "depends": {
		"minecraft": "^7.2-beta",
    "fabricloader": ">=0.15.5",
		"terrain-api": ">=1.4.4-7.2-pre1"
